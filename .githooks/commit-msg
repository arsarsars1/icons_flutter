#!/usr/bin/env bash
# Final safety check: strip Cursor agent attribution if it still appears.
set -euo pipefail

MSG_FILE="${1:?}"

[[ -f "$MSG_FILE" ]] || exit 0

tmp="$(mktemp)"
grep -viE 'co-authored-by:.*cursor|made-with:.*cursor|cursoragent@cursor\.com' "$MSG_FILE" > "$tmp" || true
mv "$tmp" "$MSG_FILE"

exit 0
